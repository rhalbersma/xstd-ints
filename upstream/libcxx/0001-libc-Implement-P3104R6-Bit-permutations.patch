+    assert(std::bit_expand(x, static_cast<T>(y & z)) == expand_one_bit_at_a_time(x, static_cast<T>(y & z)));
+    assert(std::bit_expand(x, static_cast<T>(y | z)) == expand_one_bit_at_a_time(x, static_cast<T>(y | z)));
