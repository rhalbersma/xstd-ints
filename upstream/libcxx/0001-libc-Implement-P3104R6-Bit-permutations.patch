+
+// REQUIRES: std-at-least-c++29
+
+// <bit>
+
+// The four permutations are [[nodiscard]], and a call to bit_repeat that violates
+// its precondition, l > 0, is not a core constant expression ([bit.permute]).
+
+#include <bit>
+
+void test_nodiscard() {
+  std::bit_reverse(1u);   // expected-warning {{ignoring return value of function declared with 'nodiscard' attribute}}
+  std::bit_repeat(1u, 1); // expected-warning {{ignoring return value of function declared with 'nodiscard' attribute}}
+  std::bit_compress(
+      1u, 1u);             // expected-warning {{ignoring return value of function declared with 'nodiscard' attribute}}
+  std::bit_expand(1u, 1u); // expected-warning {{ignoring return value of function declared with 'nodiscard' attribute}}
+}
+
+constexpr unsigned repeated_by_zero = std::bit_repeat(1u, 0);
+// expected-error@-1 {{constexpr variable 'repeated_by_zero' must be initialized by a constant expression}}
+// expected-note@*:* 0+ {{}}
