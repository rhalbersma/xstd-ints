+//===----------------------------------------------------------------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+// REQUIRES: std-at-least-c++29
+
+// template<class T>
+//   constexpr T bit_repeat(T x, int l);
+
+// Constraints: T is an unsigned integer type.
+
+#include <bit>
+#include <cassert>
+#include <cstdint>
+#include <limits>
+#include <type_traits>
+
+#include "test_macros.h"
+#include "type_algorithms.h"
+
+struct A {};
+enum E1 : unsigned char { rEd };
+enum class E2 : unsigned char { red };
+
+template <class T>
+concept can_bit_repeat = requires(T t) { std::bit_repeat(t, 1); };
+
+static_assert(can_bit_repeat<unsigned>, "Concept is broken. We should be able to call bit_repeat on unsigned.");
+static_assert(!can_bit_repeat<bool>);
+static_assert(!can_bit_repeat<char>);
+static_assert(!can_bit_repeat<wchar_t>);
+static_assert(!can_bit_repeat<char8_t>);
+static_assert(!can_bit_repeat<char16_t>);
+static_assert(!can_bit_repeat<char32_t>);
+static_assert(!can_bit_repeat<signed char>);
+static_assert(!can_bit_repeat<int>);
+static_assert(!can_bit_repeat<long long>);
+static_assert(!can_bit_repeat<A>);
+static_assert(!can_bit_repeat<A*>);
+static_assert(!can_bit_repeat<E1>);
+static_assert(!can_bit_repeat<E2>);
+static_assert(!can_bit_repeat<float>);
+
+// SplitMix64, so every run and every constant evaluation sees the same values.
+constexpr std::uint64_t next(std::uint64_t& state) {
+  state += 0x9E3779B97F4A7C15ULL;
+  std::uint64_t z = state;
+  z               = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9ULL;
+  z               = (z ^ (z >> 27)) * 0x94D049BB133111EBULL;
+  return z ^ (z >> 31);
+}
+
+template <class T>
+constexpr T draw(std::uint64_t& state) {
+  T value = 0;
+  for (int i = 0; i < std::numeric_limits<T>::digits; i += 64)
+    value |= static_cast<T>(static_cast<T>(next(state)) << i);
+  return value;
+}
+
+// Bit i of the result is bit i % l of x, one bit at a time.
+template <class T>
+constexpr T repeat_one_bit_at_a_time(T x, int l) {
+  constexpr int width = std::numeric_limits<T>::digits;
+  T result            = 0;
+  for (int i = 0; i < width; ++i)
+    result |= static_cast<T>(static_cast<T>((x >> (i % l)) & 1) << i);
+  return result;
+}
+
+template <class T>
+constexpr bool test() {
+  constexpr int width = std::numeric_limits<T>::digits;
+  constexpr T ones    = static_cast<T>(~T(0));
+
+  ASSERT_SAME_TYPE(decltype(std::bit_repeat(T(), 1)), T);
+  ASSERT_NOT_NOEXCEPT(std::bit_repeat(T(), 1));
+
+  assert(std::bit_repeat(T(0), 1) == T(0));
+  assert(std::bit_repeat(T(1), 1) == ones);
+  assert(std::bit_repeat(ones, 1) == ones);
+  assert(std::bit_repeat(ones, width) == ones);
+  assert(std::bit_repeat(T(1), width) == T(1));
+  // A length at or past the width leaves x as it is.
+  assert(std::bit_repeat(static_cast<T>(ones - 1), width) == static_cast<T>(ones - 1));
+  assert(std::bit_repeat(static_cast<T>(ones - 1), width + 1) == static_cast<T>(ones - 1));
+  assert(std::bit_repeat(static_cast<T>(ones - 1), std::numeric_limits<int>::max()) == static_cast<T>(ones - 1));
+  for (int l = 1; l <= width + 1; l += (width > 64 ? 5 : 1)) {
+    assert(std::bit_repeat(T(1), l) == repeat_one_bit_at_a_time(T(1), l));
+    assert(std::bit_repeat(ones, l) == ones);
+  }
+
+  std::uint64_t state = width;
+  for (int i = 0; i < 16; ++i) {
+    T x = draw<T>(state);
+    T y = draw<T>(state);
+    T z = draw<T>(state);
+    for (int l = 1; l <= width + 1; l += (width > 16 ? 9 : 1))
+      assert(std::bit_repeat(x, l) == repeat_one_bit_at_a_time(x, l));
+    (void)y;
+    (void)z;
+  }
+  return true;
+}
+
+int main(int, char**) {
+  constexpr auto test_type = []<class T> {
+    static_assert(test<T>());
+    test<T>();
+  };
+
+  types::for_each(types::unsigned_integer_types{}, test_type);
+
+#if TEST_HAS_BITINT
+  using bitint_types = types::type_list<
+      unsigned _BitInt(2),
+      unsigned _BitInt(13),
+      unsigned _BitInt(32),
+      unsigned _BitInt(64),
+      unsigned _BitInt(65)
+#  if __BITINT_MAXWIDTH__ >= 147
+          ,
+      unsigned _BitInt(128),
+      unsigned _BitInt(147)
+#  endif
+#  if __BITINT_MAXWIDTH__ >= 256
+          ,
+      unsigned _BitInt(256)
+#  endif
+      >;
+  types::for_each(bitint_types{}, test_type);
+#endif
+
+  return 0;
+}
