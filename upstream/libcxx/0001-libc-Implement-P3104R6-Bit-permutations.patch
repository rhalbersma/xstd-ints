+static_assert(!can_bit_expand<bool>);
+static_assert(!can_bit_expand<char>);
+static_assert(!can_bit_expand<wchar_t>);
+static_assert(!can_bit_expand<char8_t>);
+static_assert(!can_bit_expand<char16_t>);
+static_assert(!can_bit_expand<char32_t>);
+static_assert(!can_bit_expand<signed char>);
+static_assert(!can_bit_expand<int>);
+static_assert(!can_bit_expand<long long>);
+static_assert(!can_bit_expand<A>);
+static_assert(!can_bit_expand<A*>);
+static_assert(!can_bit_expand<E1>);
+static_assert(!can_bit_expand<E2>);
+static_assert(!can_bit_expand<float>);
+
+// SplitMix64, so every run and every constant evaluation sees the same values.
+constexpr std::uint64_t next(std::uint64_t& state) {
+  state += 0x9E3779B97F4A7C15ULL;
+  std::uint64_t z = state;
+  z               = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9ULL;
+  z               = (z ^ (z >> 27)) * 0x94D049BB133111EBULL;
+  return z ^ (z >> 31);
+}
+
+template <class T>
+constexpr T draw(std::uint64_t& state) {
+  T value = 0;
+  for (int i = 0; i < std::numeric_limits<T>::digits; i += 64)
+    value |= static_cast<T>(static_cast<T>(next(state)) << i);
+  return value;
+}
+
+// Each position that m selects takes the next bit of x from the bottom, one bit at a time.
+template <class T>
+constexpr T expand_one_bit_at_a_time(T x, T m) {
+  constexpr int width = std::numeric_limits<T>::digits;
+  T result            = 0;
+  int next_source     = 0;
+  for (int i = 0; i < width; ++i) {
+    if ((m >> i) & 1) {
+      result |= static_cast<T>(static_cast<T>((x >> next_source) & 1) << i);
+      ++next_source;
+    }
+  }
+  return result;
+}
+
+template <class T>
+constexpr bool test() {
+  constexpr int width = std::numeric_limits<T>::digits;
+  constexpr T ones    = static_cast<T>(~T(0));
+
+  ASSERT_SAME_TYPE(decltype(std::bit_expand(T(), T())), T);
+  ASSERT_NOEXCEPT(std::bit_expand(T(), T()));
+
+  assert(std::bit_expand(ones, T(0)) == T(0));
+  assert(std::bit_expand(T(0), ones) == T(0));
+  assert(std::bit_expand(ones, ones) == ones);
+  assert(std::bit_expand(T(0b1011 & ones), T(0b1111'0000 & ones)) ==
+         expand_one_bit_at_a_time(T(0b1011 & ones), T(0b1111'0000 & ones)));
+  for (int i = 0; i < width; i += (width > 64 ? 7 : 1)) {
+    T bit = static_cast<T>(T(1) << i);
+    assert(std::bit_expand(ones, bit) == bit);
+    assert(std::bit_expand(T(1), bit) == bit);
+    assert(std::bit_expand(T(0), bit) == T(0));
+    assert(std::bit_expand(ones, static_cast<T>(ones ^ bit)) == static_cast<T>(ones ^ bit));
+  }
