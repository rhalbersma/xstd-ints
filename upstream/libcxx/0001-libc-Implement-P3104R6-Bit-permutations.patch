+
+// <bit>
+
+// template<class T>
+//   constexpr T bit_repeat(T x, int l);
+//
+// Preconditions: l > 0.
+
+#include <bit>
+
+#include "check_assertion.h"
+
+int main(int, char**) {
+  TEST_LIBCPP_ASSERT_FAILURE(std::bit_repeat(1u, 0), "bit_repeat requires a positive length");
+  TEST_LIBCPP_ASSERT_FAILURE(std::bit_repeat(1u, -1), "bit_repeat requires a positive length");
+  TEST_LIBCPP_ASSERT_FAILURE(std::bit_repeat(1ull, -64), "bit_repeat requires a positive length");
+
+  return 0;
+}
