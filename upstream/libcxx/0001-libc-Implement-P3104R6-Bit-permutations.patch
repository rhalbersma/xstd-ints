diff --git a/libcxx/include/__bit/permute.h b/libcxx/include/__bit/permute.h
new file mode 100644
index 00000000..371d6de8
--- /dev/null
+++ b/libcxx/include/__bit/permute.h
@@ -0,0 +1,167 @@
+//===----------------------------------------------------------------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#ifndef _LIBCPP___BIT_PERMUTE_H
+#define _LIBCPP___BIT_PERMUTE_H
+
+#include <__assert>
+#include <__config>
+#include <__type_traits/integer_traits.h>
+#include <limits>
+
+#if !defined(_LIBCPP_HAS_NO_PRAGMA_SYSTEM_HEADER)
+#  pragma GCC system_header
+#endif
+
+#if _LIBCPP_STD_VER >= 29
+
+_LIBCPP_BEGIN_NAMESPACE_STD
+
+// PEXT and PDEP are microcoded on AMD processors before Zen 3, so a build targeting one keeps the portable kernels.
+#  if defined(__x86_64__) && defined(__BMI2__) && !defined(__bdver4__) && !defined(__znver1__) && !defined(__znver2__)
+#    define _LIBCPP_HAS_FAST_PEXT_PDEP 1
+#  else
+#    define _LIBCPP_HAS_FAST_PEXT_PDEP 0
+#  endif
+
+// The four permutations work a 64-bit block at a time, which covers every unsigned integer type up to
+// `unsigned _BitInt(N)` of any width.
+using __bit_permute_block = unsigned long long;
+
+inline constexpr int __bit_permute_block_width = numeric_limits<__bit_permute_block>::digits;
+
+[[nodiscard]] _LIBCPP_HIDE_FROM_ABI constexpr __bit_permute_block
+__bit_reverse_block(__bit_permute_block __x) noexcept {
+#  if __has_builtin(__builtin_bitreverse64)
+  return __builtin_bitreverse64(__x);
+#  else
+  // Mirror the bytes, then the nibbles, pairs and single bits within each byte.
+  __x = __builtin_bswap64(__x);
+  __x = ((__x >> 4) & 0x0F0F0F0F0F0F0F0FULL) | ((__x & 0x0F0F0F0F0F0F0F0FULL) << 4);
+  __x = ((__x >> 2) & 0x3333333333333333ULL) | ((__x & 0x3333333333333333ULL) << 2);
+  __x = ((__x >> 1) & 0x5555555555555555ULL) | ((__x & 0x5555555555555555ULL) << 1);
+  return __x;
+#  endif
+}
+
+[[nodiscard]] _LIBCPP_HIDE_FROM_ABI constexpr __bit_permute_block
+__bit_compress_block(__bit_permute_block __x, __bit_permute_block __m) noexcept {
+#  if _LIBCPP_HAS_FAST_PEXT_PDEP
+  if !consteval {
+#    if __has_builtin(__builtin_elementwise_pext)
+    return __builtin_elementwise_pext(__x, __m);
+#    else
+    return __builtin_ia32_pext_di(__x, __m);
+#    endif
+  }
+#  endif
+  // Each selected bit lands at its rank among the mask's ones: one popcount per selected bit, none per mask bit.
+  __bit_permute_block __r = 0;
+  for (__bit_permute_block __s = __x & __m; __s != 0; __s &= __s - 1) {
+    __bit_permute_block __below_lowest = (__s - 1) & ~__s;
+    __r |= __bit_permute_block(1) << __builtin_popcountll(__below_lowest & __m);
+  }
+  return __r;
+}
+
+[[nodiscard]] _LIBCPP_HIDE_FROM_ABI constexpr __bit_permute_block
+__bit_expand_block(__bit_permute_block __x, __bit_permute_block __m) noexcept {
+#  if _LIBCPP_HAS_FAST_PEXT_PDEP
+  if !consteval {
+#    if __has_builtin(__builtin_elementwise_pdep)
+    return __builtin_elementwise_pdep(__x, __m);
+#    else
+    return __builtin_ia32_pdep_di(__x, __m);
+#    endif
+  }
+#  endif
+  // Each one of the mask, lowest first, takes the next bit of the source, selected by a mask rather than a branch.
+  __bit_permute_block __r = 0;
+  for (; __m != 0; __m &= __m - 1, __x >>= 1)
+    __r |= (__m & -__m) & -(__x & 1);
+  return __r;
+}
+
+template <__unsigned_integer _Tp>
+[[nodiscard]] _LIBCPP_HIDE_FROM_ABI constexpr _Tp bit_reverse(_Tp __x) noexcept {
+  constexpr int __n = numeric_limits<_Tp>::digits;
+  constexpr int __w = __bit_permute_block_width;
+  if constexpr (__n <= __w) {
+    return static_cast<_Tp>(std::__bit_reverse_block(static_cast<__bit_permute_block>(__x)) >> (__w - __n));
+  } else {
+    // Each whole block is mirrored and lands at the mirror of its offset; a partial top block lands at the bottom.
+    constexpr int __partial = __n % __w;
+    _Tp __r                 = 0;
+    for (int __k = 0; __k + __w <= __n; __k += __w)
+      __r |= static_cast<_Tp>(std::__bit_reverse_block(static_cast<__bit_permute_block>(__x >> __k)))
+          << (__n - __w - __k);
+    if constexpr (__partial != 0)
+      __r |= static_cast<_Tp>(
+          std::__bit_reverse_block(static_cast<__bit_permute_block>(__x >> (__n - __partial))) >> (__w - __partial));
+    return __r;
+  }
+}
+
+template <__unsigned_integer _Tp>
+[[nodiscard]] _LIBCPP_HIDE_FROM_ABI constexpr _Tp bit_repeat(_Tp __x, int __l) {
+  _LIBCPP_ASSERT_ARGUMENT_WITHIN_DOMAIN(__l > 0, "bit_repeat requires a positive length");
+  // [bit.permute]: a call violating the precondition is not a core constant expression.
+  if consteval {
+    if (__l <= 0)
+      __builtin_unreachable();
+  }
+  constexpr int __n = numeric_limits<_Tp>::digits;
+  if (__l >= __n)
+    return __x;
+  __x &= static_cast<_Tp>((_Tp(1) << __l) - 1);
+  for (; __l < __n; __l <<= 1)
+    __x |= static_cast<_Tp>(__x << __l);
+  return __x;
+}
+
+template <__unsigned_integer _Tp>
+[[nodiscard]] _LIBCPP_HIDE_FROM_ABI constexpr _Tp bit_compress(_Tp __x, _Tp __m) noexcept {
+  constexpr int __n = numeric_limits<_Tp>::digits;
+  constexpr int __w = __bit_permute_block_width;
+  // Each block's selected bits are packed above those the lower blocks selected.
+  _Tp __r      = 0;
+  int __packed = 0;
+  for (int __k = 0; __k < __n; __k += __w) {
+    __bit_permute_block __m_block = static_cast<__bit_permute_block>(__m >> __k);
+    __r |= static_cast<_Tp>(
+        static_cast<_Tp>(std::__bit_compress_block(static_cast<__bit_permute_block>(__x >> __k), __m_block))
+        << __packed);
+    __packed += __builtin_popcountll(__m_block);
+  }
+  return __r;
+}
+
+template <__unsigned_integer _Tp>
+[[nodiscard]] _LIBCPP_HIDE_FROM_ABI constexpr _Tp bit_expand(_Tp __x, _Tp __m) noexcept {
+  constexpr int __n = numeric_limits<_Tp>::digits;
+  constexpr int __w = __bit_permute_block_width;
+  // Each block draws its bits from where the lower blocks stopped.
+  _Tp __r        = 0;
+  int __consumed = 0;
+  for (int __k = 0; __k < __n; __k += __w) {
+    __bit_permute_block __m_block = static_cast<__bit_permute_block>(__m >> __k);
+    __r |= static_cast<_Tp>(
+        static_cast<_Tp>(std::__bit_expand_block(static_cast<__bit_permute_block>(__x >> __consumed), __m_block))
+        << __k);
+    __consumed += __builtin_popcountll(__m_block);
+  }
+  return __r;
+}
+
+#  undef _LIBCPP_HAS_FAST_PEXT_PDEP
+
+_LIBCPP_END_NAMESPACE_STD
+
+#endif // _LIBCPP_STD_VER >= 29
+
+#endif // _LIBCPP___BIT_PERMUTE_H
