+
+// template<class T>
+//   constexpr T bit_compress(T x, T m) noexcept;
+
+// Constraints: T is an unsigned integer type.
+
+#include <bit>
+#include <cassert>
+#include <cstdint>
+#include <limits>
+#include <type_traits>
+
+#include "test_macros.h"
+#include "type_algorithms.h"
+
+struct A {};
+enum E1 : unsigned char { rEd };
+enum class E2 : unsigned char { red };
+
+template <class T>
+concept can_bit_compress = requires(T t) { std::bit_compress(t, t); };
+
+static_assert(can_bit_compress<unsigned>, "Concept is broken. We should be able to call bit_compress on unsigned.");
+static_assert(!can_bit_compress<bool>);
+static_assert(!can_bit_compress<char>);
+static_assert(!can_bit_compress<wchar_t>);
+static_assert(!can_bit_compress<char8_t>);
+static_assert(!can_bit_compress<char16_t>);
+static_assert(!can_bit_compress<char32_t>);
+static_assert(!can_bit_compress<signed char>);
+static_assert(!can_bit_compress<int>);
+static_assert(!can_bit_compress<long long>);
+static_assert(!can_bit_compress<A>);
+static_assert(!can_bit_compress<A*>);
+static_assert(!can_bit_compress<E1>);
+static_assert(!can_bit_compress<E2>);
+static_assert(!can_bit_compress<float>);
+
+// SplitMix64, so every run and every constant evaluation sees the same values.
+constexpr std::uint64_t next(std::uint64_t& state) {
+  state += 0x9E3779B97F4A7C15ULL;
+  std::uint64_t z = state;
+  z               = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9ULL;
+  z               = (z ^ (z >> 27)) * 0x94D049BB133111EBULL;
+  return z ^ (z >> 31);
+}
+
+template <class T>
+constexpr T draw(std::uint64_t& state) {
+  T value = 0;
+  for (int i = 0; i < std::numeric_limits<T>::digits; i += 64)
+    value |= static_cast<T>(static_cast<T>(next(state)) << i);
+  return value;
+}
+
+// Each bit of x that m selects goes to the next position from the bottom, one bit at a time.
+template <class T>
+constexpr T compress_one_bit_at_a_time(T x, T m) {
+  constexpr int width = std::numeric_limits<T>::digits;
+  T result            = 0;
+  int next_position   = 0;
+  for (int i = 0; i < width; ++i) {
+    if ((m >> i) & 1) {
+      result |= static_cast<T>(static_cast<T>((x >> i) & 1) << next_position);
+      ++next_position;
+    }
+  }
+  return result;
+}
+
+template <class T>
+constexpr bool test() {
+  constexpr int width = std::numeric_limits<T>::digits;
+  constexpr T ones    = static_cast<T>(~T(0));
+
+  ASSERT_SAME_TYPE(decltype(std::bit_compress(T(), T())), T);
+  ASSERT_NOEXCEPT(std::bit_compress(T(), T()));
+
+  assert(std::bit_compress(ones, T(0)) == T(0));
+  assert(std::bit_compress(T(0), ones) == T(0));
+  assert(std::bit_compress(ones, ones) == ones);
+  assert(std::bit_compress(T(0b1011'0110 & ones), T(0b1111'0000 & ones)) ==
+         compress_one_bit_at_a_time(T(0b1011'0110 & ones), T(0b1111'0000 & ones)));
+  for (int i = 0; i < width; i += (width > 64 ? 7 : 1)) {
+    T bit = static_cast<T>(T(1) << i);
+    assert(std::bit_compress(ones, bit) == T(1));
+    assert(std::bit_compress(bit, bit) == T(1));
+    assert(std::bit_compress(static_cast<T>(ones ^ bit), bit) == T(0));
+    assert(std::bit_compress(ones, static_cast<T>(ones ^ bit)) == static_cast<T>(ones >> 1));
+    assert(std::bit_compress(bit, static_cast<T>(ones ^ static_cast<T>(bit - 1))) == T(1));
+  }
+
+  std::uint64_t state = width;
+  for (int i = 0; i < 16; ++i) {
+    T x = draw<T>(state);
+    T y = draw<T>(state);
+    T z = draw<T>(state);
+    assert(std::bit_compress(x, y) == compress_one_bit_at_a_time(x, y));
+    assert(std::bit_compress(x, static_cast<T>(y & z)) == compress_one_bit_at_a_time(x, static_cast<T>(y & z)));
+    assert(std::bit_compress(x, static_cast<T>(y | z)) == compress_one_bit_at_a_time(x, static_cast<T>(y | z)));
+    // Expanding what was compressed gives back the bits the mask selected.
+    assert(std::bit_expand(std::bit_compress(x, y), y) == static_cast<T>(x & y));
+  }
+  return true;
+}
+
+int main(int, char**) {
+  constexpr auto test_type = []<class T> {
+    static_assert(test<T>());
+    test<T>();
+  };
+
+  types::for_each(types::unsigned_integer_types{}, test_type);
+
+#if TEST_HAS_BITINT
+  using bitint_types = types::type_list<
+      unsigned _BitInt(2),
+      unsigned _BitInt(13),
+      unsigned _BitInt(32),
+      unsigned _BitInt(64),
+      unsigned _BitInt(65)
+#  if __BITINT_MAXWIDTH__ >= 147
+          ,
+      unsigned _BitInt(128),
+      unsigned _BitInt(147)
+#  endif
+#  if __BITINT_MAXWIDTH__ >= 256
+          ,
+      unsigned _BitInt(256)
+#  endif
+      >;
+  types::for_each(bitint_types{}, test_type);
+#endif
+
+  return 0;
+}
